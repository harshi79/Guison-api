# Required for remote Turso/libSQL. Get both from `turso db show --url` and
# `turso db tokens create <database>`. The URL must start with libsql://.
TURSO_DATABASE_URL=libsql://example-your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Required everywhere. Use a unique value of at least 16 characters and HTTPS.
DATA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Use HTTP_ADDR locally. Many hosting providers set PORT automatically instead.
HTTP_ADDR=:8080
# PORT=8080

# Automatic GitHub dataset import
SYNC_ENABLED=true
SYNC_ON_START=true
SYNC_INTERVAL=5m
GITHUB_TOKEN=

# Optional custom source list. Use one, not both.
# SOURCES_FILE=config/sources.example.json
# SOURCES_JSON=[{"id":"source","repository":"owner/repo","branch":"main","path":"bins.csv","format":"binlist","priority":100,"min_records":100}]

MAX_DOWNLOAD_BYTES=104857600
MAX_INVALID_RATIO=0.05
SHUTDOWN_TIMEOUT=15s

# Public website community links. Optional.
# Leave empty and the site shows a disabled button with a setup hint instead of
# a fake username. Must start with https:// to be accepted.
TELEGRAM_CHANNEL_URL=
TELEGRAM_PRIVATE_URL=
DEVELOPER_TELEGRAM_URL=
