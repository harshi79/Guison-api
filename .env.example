# Required outside Docker Compose
DATABASE_URL=postgres://binapi:binapi@localhost:5432/binapi?sslmode=disable

HTTP_ADDR=:8080
SYNC_ENABLED=true
SYNC_ON_START=true
SYNC_INTERVAL=5m

# This token is used only by the server to read community repositories.
# API consumers never need a token or API key.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
SYNC_ADMIN_TOKEN=

SOURCES_FILE=config/sources.example.json
MAX_DOWNLOAD_BYTES=104857600
MAX_INVALID_RATIO=0.05
CACHE_TTL=5m
CACHE_MAX_ENTRIES=100000
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONNS=20
SHUTDOWN_TIMEOUT=15s
