# Required when running the binary directly. Docker Compose uses its PostgreSQL service.
DATABASE_URL=postgres://binapi:binapi@localhost:5432/binapi?sslmode=disable

# Required everywhere. Use a unique value of at least 16 characters and HTTPS.
DATA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Use HTTP_ADDR locally. Many hosting providers set PORT automatically instead.
HTTP_ADDR=:8080
# PORT=8080

# Automatic GitHub dataset import
SYNC_ENABLED=true
SYNC_ON_START=true
SYNC_INTERVAL=5m
GITHUB_TOKEN=

# Optional custom source list. Use one, not both.
# SOURCES_FILE=config/sources.example.json
# SOURCES_JSON=[{"id":"source","repository":"owner/repo","branch":"main","path":"bins.csv","format":"binlist","priority":100,"min_records":100}]

MAX_DOWNLOAD_BYTES=104857600
MAX_INVALID_RATIO=0.05
DATABASE_MAX_CONNS=10
SHUTDOWN_TIMEOUT=15s
